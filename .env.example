# Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------
# Core skill
# ---------------------------------------------------------------

# Contact URL or email included in the User-Agent header sent to
# Wikimedia APIs, as required by the Wikimedia User-Agent policy:
# https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
# Default when unset: https://github.com/OlehDribko/wikipedia-market-research/issues
WMR_CONTACT=

# Optional cache directory. Default: $XDG_CACHE_HOME/wikipedia-market-research
# or ~/.cache/wikipedia-market-research
# WMR_CACHE_DIR=

# ---------------------------------------------------------------
# Development harness only (harness/openrouter).
# Never read by the skill itself.
# ---------------------------------------------------------------

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
